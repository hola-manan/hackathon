# Copy to .env and fill in to switch from demo stubs to live integrations.

# --- WhatsApp Business Cloud API (helpline number below) ---
WHATSAPP_PHONE_NUMBER=9461330316
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=kisan-alert-verify

# --- Bhashini (ULCA / Dhruva) ---
# Get both from https://bhashini.gov.in/ulca -> register -> My Profile.
# USER_ID is shown on your profile; API_KEY via the "Generate" button.
# INFERENCE_KEY is optional: the getModelsPipeline config call returns a
# per-request inference key automatically, so leave it blank for the ULCA flow.
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_INFERENCE_KEY=
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd

# --- Sarvam AI (alternative Indic language stack; single-key) ---
# Get the key from https://dashboard.sarvam.ai. If set, it is used by default.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_TRANSLATE_MODEL=mayura:v1
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TTS_SPEAKER=anushka

# Indic language provider: sarvam | bhashini | auto (auto prefers Sarvam).
LANGUAGE_PROVIDER=auto

# --- Claude (advisory narration + vision diagnosis) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# --- App ---
DEFAULT_LANGUAGE=te
